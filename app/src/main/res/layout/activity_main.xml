<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome"
    android:orientation="horizontal">

    <!-- Barra lateral: carpetas, copia en Google Drive y modo oscuro. -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="@color/sidebar"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="14dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingBottom="4dp"
            android:text="@string/folders"
            android:textAllCaps="true"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <LinearLayout
                android:id="@+id/folders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/cloud"
            style="@style/SidebarItem"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:paddingVertical="6dp"
            android:singleLine="false"
            android:maxLines="2"
            android:drawableStart="@drawable/ic_cloud"
            android:text="@string/cloud_connect" />

        <TextView
            android:id="@+id/dark"
            style="@style/SidebarItem"
            android:drawableStart="@drawable/ic_dark"
            android:text="@string/dark_mode" />

        <TextView
            android:id="@+id/settings"
            style="@style/SidebarItem"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/settings" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/folder_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/search"
                android:layout_width="260dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:hint="@string/search_notes"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/import_jnotes"
                style="@style/TextButton"
                android:drawableStart="@drawable/ic_import"
                android:text="@string/import_jnotes" />

            <Button
                android:id="@+id/new_note"
                style="@style/TextButton"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/new_note" />
        </LinearLayout>

        <TextView
            android:id="@+id/search_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingBottom="6dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:padding="32dp"
                android:text="@string/empty"
                android:textColor="@color/muted"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
